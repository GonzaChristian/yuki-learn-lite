<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/yuki_background"
    tools:context=".LessonActivity">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_yuki"
            android:contentDescription="@string/units_back" />

        <TextView
            android:id="@+id/txtLessonTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/yuki_text_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold"
            tools:text="Variables" />

        <TextView
            android:id="@+id/txtStepCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:textColor="@color/yuki_text_secondary"
            android:textSize="@dimen/text_secondary"
            tools:text="1 / 3" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLesson"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:progressTint="@color/yuki_primary"
        android:progressBackgroundTint="@color/yuki_secondary"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido educativo -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLesson"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/progressLesson"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <ImageView
                android:id="@+id/imgLuna"
                android:layout_width="@dimen/luna_large"
                android:layout_height="@dimen/luna_large"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_normal"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="@string/lesson_luna_description" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center"
                android:text="@string/lesson_luna_tutor"
                android:textColor="@color/yuki_primary"
                android:textSize="@dimen/text_card"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_profile_card"
                android:padding="@dimen/space_large"
                android:textColor="@color/yuki_text_primary"
                android:textSize="@dimen/text_card"
                android:lineSpacingExtra="4dp"
                tools:text="Una variable permite guardar información." />

            <!-- Código Java -->
            <LinearLayout
                android:id="@+id/cardCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/space_large"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lesson_code_label"
                    android:textColor="@color/yuki_primary"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_normal"
                    android:fontFamily="monospace"
                    android:textColor="@color/yuki_text_primary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="4dp"
                    tools:text="int edad = 18;" />

            </LinearLayout>

            <!-- Explicación complementaria -->
            <TextView
                android:id="@+id/txtExtraContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:background="@drawable/bg_main_hero"
                android:padding="@dimen/space_large"
                android:textColor="@color/yuki_text_primary"
                android:textSize="@dimen/text_body"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"
                tools:text="Tipo: int, Nombre: edad, Valor: 18" />

            <!-- Comentario opcional de Yuki -->
            <LinearLayout
                android:id="@+id/layoutYukiReaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgYuki"
                    android:layout_width="@dimen/yuki_small"
                    android:layout_height="@dimen/yuki_small"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/splash_yuki_description" />

                <TextView
                    android:id="@+id/txtYukiMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_normal"
                    android:textColor="@color/yuki_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="¡Ya lo entiendo!" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Botón fijo inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/lesson_next"
        android:textColor="@color/yuki_on_primary"
        android:textSize="@dimen/text_card"
        app:backgroundTint="@color/yuki_primary"
        app:cornerRadius="@dimen/button_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
