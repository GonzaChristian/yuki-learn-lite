<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/yuki_background"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBackQuiz"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_yuki"
            android:contentDescription="@string/quiz_exit" />

        <TextView
            android:id="@+id/txtQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/yuki_text_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtQuestionCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:textColor="@color/yuki_text_secondary"
            android:textSize="@dimen/text_secondary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressQuiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:progressTint="@color/yuki_primary"
        android:progressBackgroundTint="@color/yuki_secondary" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollQuiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <TextView
                android:id="@+id/txtQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:textColor="@color/yuki_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_normal"
                android:textColor="@color/yuki_text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Una respuesta -->
            <RadioGroup
                android:id="@+id/groupRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/space_large"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/radio0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <RadioButton
                    android:id="@+id/radio1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <RadioButton
                    android:id="@+id/radio2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <RadioButton
                    android:id="@+id/radio3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

            </RadioGroup>

            <!-- Varias respuestas -->
            <LinearLayout
                android:id="@+id/groupChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/space_large"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/check0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <CheckBox
                    android:id="@+id/check1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <CheckBox
                    android:id="@+id/check2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

                <CheckBox
                    android:id="@+id/check3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textColor="@color/yuki_text_primary" />

            </LinearLayout>

            <!-- Lista desplegable -->
            <Spinner
                android:id="@+id/spinnerAnswer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_input"
                android:paddingStart="@dimen/space_normal"
                android:paddingEnd="@dimen/space_normal"
                android:visibility="gone" />

            <!-- Respuesta escrita -->
            <EditText
                android:id="@+id/edtAnswer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_input"
                android:hint="@string/quiz_answer_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:paddingStart="@dimen/space_normal"
                android:paddingEnd="@dimen/space_normal"
                android:textColor="@color/yuki_text_primary"
                android:textColorHint="@color/yuki_text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <!-- Comentario después de responder -->
            <TextView
                android:id="@+id/txtFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_card"
                android:padding="@dimen/space_large"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheck"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_small"
        android:layout_marginBottom="@dimen/screen_margin"
        android:text="@string/quiz_check"
        android:textColor="@color/yuki_on_primary"
        android:textSize="@dimen/text_card"
        app:backgroundTint="@color/yuki_primary"
        app:cornerRadius="@dimen/button_radius" />

</LinearLayout>
