<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/yuki_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/yuki_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/main_greeting_preview"
                    android:textColor="@color/yuki_text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_level_pill"
                android:padding="12dp"
                android:text="@string/main_level_preview"
                android:textColor="@color/yuki_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Yuki -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_main_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_large">

            <ImageView
                android:id="@+id/imgYuki"
                android:layout_width="@dimen/yuki_small"
                android:layout_height="@dimen/yuki_small"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="@string/splash_yuki_description" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_normal"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_yuki_name"
                    android:textColor="@color/yuki_primary"
                    android:textSize="@dimen/text_card"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtYukiMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/main_yuki_message"
                    android:textColor="@color/yuki_text_primary"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

        </LinearLayout>

        <!-- Experiencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_experience"
                    android:textColor="@color/yuki_text_primary"
                    android:textSize="@dimen/text_card"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_xp_preview"
                    android:textColor="@color/yuki_primary"
                    android:textSize="@dimen/text_card"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressXp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_large"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/yuki_primary"
                android:progressBackgroundTint="@color/yuki_secondary" />

            <TextView
                android:id="@+id/txtXpNextLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/main_xp_next_preview"
                android:textColor="@color/yuki_text_secondary"
                android:textSize="@dimen/text_secondary" />

        </LinearLayout>

        <!-- Continuar aprendiendo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_next_label"
                android:textColor="@color/yuki_text_secondary"
                android:textSize="@dimen/text_secondary" />

            <TextView
                android:id="@+id/txtContinueLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/main_next_preview"
                android:textColor="@color/yuki_text_primary"
                android:textSize="@dimen/text_card"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/main_continue"
                android:textColor="@color/yuki_on_primary"
                android:textSize="@dimen/text_card"
                app:backgroundTint="@color/yuki_primary"
                app:cornerRadius="@dimen/button_radius" />

        </LinearLayout>

        <!-- Navegación -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLearn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:text="@string/main_learn"
            android:textColor="@color/yuki_primary"
            android:textSize="@dimen/text_card"
            app:backgroundTint="@color/yuki_surface"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/yuki_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/main_progress"
            android:textColor="@color/yuki_primary"
            android:textSize="@dimen/text_card"
            app:backgroundTint="@color/yuki_surface"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/yuki_primary"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
